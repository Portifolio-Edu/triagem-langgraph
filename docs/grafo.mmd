---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	normaliza(normaliza)
	classifica(classifica)
	decide(decide)
	registra(registra)
	humano(humano)
	redige(redige)
	valida(valida)
	__end__([<p>__end__</p>]):::last
	__start__ --> normaliza;
	classifica --> decide;
	decide --> registra;
	humano --> redige;
	normaliza -.-> classifica;
	normaliza -.-> redige;
	redige --> valida;
	registra -.-> humano;
	registra -.-> redige;
	valida --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

